{
  "$defs": {
    "AgentExecutionStatus": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "AgentExecutionStatus",
      "type": "string"
    },
    "AgentExtractionStage": {
      "enum": [
        "D0_SOURCE_PREFLIGHT",
        "D1_DOCUMENT_UNDERSTANDING",
        "D2_LOGICAL_STRUCTURE",
        "D3_PARENT_PROVISION_RECOGNITION",
        "D4_REQUIREMENT_DECOMPOSITION",
        "D5_COMPLETENESS_VERIFICATION",
        "D6_RESULT_ASSEMBLY"
      ],
      "title": "AgentExtractionStage",
      "type": "string"
    },
    "AgentKitIdentityV1": {
      "additionalProperties": false,
      "description": "Exact, runner-neutral identity of one Portable Agent Kit bundle.",
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "kit_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Kit Id",
          "type": "string"
        },
        "kit_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Kit Version",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "reqpilotx-agent-kit-identity/v1",
          "default": "reqpilotx-agent-kit-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_registry_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Tool Registry Id",
          "type": "string"
        },
        "tool_registry_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Tool Registry Version",
          "type": "string"
        }
      },
      "required": [
        "kit_id",
        "kit_version",
        "manifest_sha256",
        "bundle_sha256",
        "policy_id",
        "policy_version",
        "tool_registry_id",
        "tool_registry_version"
      ],
      "title": "AgentKitIdentityV1",
      "type": "object"
    },
    "AgentProgressBasis": {
      "enum": [
        "SOURCE",
        "PAGES",
        "LOGICAL_CONTAINERS",
        "PARENT_PROVISIONS",
        "ASSERTIONS",
        "SOURCE_SCOPES"
      ],
      "title": "AgentProgressBasis",
      "type": "string"
    },
    "AgentRunEventKind": {
      "enum": [
        "RUN_STARTED",
        "STAGE_STARTED",
        "STAGE_PROGRESS",
        "TOOL_COMPLETED",
        "ARTIFACT_VALIDATED",
        "STAGE_COMPLETED",
        "RUN_COMPLETED",
        "RUN_BLOCKED",
        "RUN_FAILED",
        "RUN_CANCELLED"
      ],
      "title": "AgentRunEventKind",
      "type": "string"
    },
    "AgentRunEventV1": {
      "additionalProperties": false,
      "description": "Content-free event consumed identically by every ReqPilotX runner.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^agent-artifact-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "completed_units": {
          "default": 0,
          "minimum": 0,
          "title": "Completed Units",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AgentRunEventKind"
        },
        "message_code": {
          "default": "",
          "pattern": "^[a-z0-9_]{0,120}$",
          "title": "Message Code",
          "type": "string"
        },
        "progress_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentProgressBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "pattern": "^agent-run-[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "reqpilotx-agent-run-event/v1",
          "default": "reqpilotx-agent-run-event/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentExtractionStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_units": {
          "default": 0,
          "minimum": 0,
          "title": "Total Units",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "sequence",
        "kind"
      ],
      "title": "AgentRunEventV1",
      "type": "object"
    },
    "AgentRunnerIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Adapter Version",
          "type": "string"
        },
        "runner_kind": {
          "$ref": "#/$defs/AgentRunnerKind"
        },
        "runner_profile_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Runner Profile Id",
          "type": "string"
        },
        "runner_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runner Profile Sha256",
          "type": "string"
        },
        "runtime_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "required": [
        "runner_profile_id",
        "runner_profile_sha256",
        "runner_kind",
        "adapter_id",
        "adapter_version",
        "runtime_version"
      ],
      "title": "AgentRunnerIdentityV1",
      "type": "object"
    },
    "AgentRunnerKind": {
      "enum": [
        "DESKTOP_REFERENCE",
        "APP_SERVER_PRODUCT"
      ],
      "title": "AgentRunnerKind",
      "type": "string"
    },
    "AgentStageArtifactStatus": {
      "enum": [
        "VALIDATED",
        "PARTIAL",
        "BLOCKED"
      ],
      "title": "AgentStageArtifactStatus",
      "type": "string"
    },
    "AgentStageArtifactV1": {
      "additionalProperties": false,
      "description": "Content-free reference to one validated stage payload and its evidence.",
      "properties": {
        "artifact_id": {
          "pattern": "^agent-artifact-[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "diagnostic_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostic Codes",
          "type": "array"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "predecessor_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Predecessor Artifact Ids",
          "type": "array"
        },
        "proposal_schema_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}/v[0-9]+$",
          "title": "Proposal Schema Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^agent-run-[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "reqpilotx-agent-stage-artifact/v1",
          "default": "reqpilotx-agent-stage-artifact/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/AgentExtractionStage"
        },
        "status": {
          "$ref": "#/$defs/AgentStageArtifactStatus"
        },
        "unresolved_scope_count": {
          "default": 0,
          "minimum": 0,
          "title": "Unresolved Scope Count",
          "type": "integer"
        },
        "validator_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validator Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "run_id",
        "source_sha256",
        "stage",
        "status",
        "proposal_schema_id",
        "payload_sha256",
        "evidence_sha256",
        "validator_receipt_sha256"
      ],
      "title": "AgentStageArtifactV1",
      "type": "object"
    },
    "AgentWorkflowMode": {
      "description": "The two product workflows intentionally have different stage orders.",
      "enum": [
        "BASELINE",
        "ATOMIZATION"
      ],
      "title": "AgentWorkflowMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_baseline_artifact_id": {
      "anyOf": [
        {
          "pattern": "^agent-artifact-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Baseline Artifact Id"
    },
    "accepted_baseline_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Baseline Artifact Sha256"
    },
    "diagnostic_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Diagnostic Codes",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/AgentRunEventV1"
      },
      "title": "Events",
      "type": "array"
    },
    "explicit_user_trigger": {
      "default": false,
      "title": "Explicit User Trigger",
      "type": "boolean"
    },
    "kit_identity": {
      "$ref": "#/$defs/AgentKitIdentityV1"
    },
    "requested_stages": {
      "items": {
        "$ref": "#/$defs/AgentExtractionStage"
      },
      "title": "Requested Stages",
      "type": "array"
    },
    "run_id": {
      "pattern": "^agent-run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "runner_identity": {
      "$ref": "#/$defs/AgentRunnerIdentityV1"
    },
    "schema_version": {
      "const": "reqpilotx-agent-execution-result/v1",
      "default": "reqpilotx-agent-execution-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_scope_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Scope Sha256"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "stage_artifacts": {
      "items": {
        "$ref": "#/$defs/AgentStageArtifactV1"
      },
      "title": "Stage Artifacts",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/AgentExecutionStatus"
    },
    "workflow_mode": {
      "$ref": "#/$defs/AgentWorkflowMode",
      "default": "BASELINE"
    }
  },
  "required": [
    "run_id",
    "source_sha256",
    "kit_identity",
    "runner_identity",
    "requested_stages",
    "status",
    "events",
    "stage_artifacts"
  ],
  "title": "AgentExecutionResultV1",
  "type": "object"
}
