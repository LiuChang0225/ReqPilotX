{
  "$defs": {
    "AgentKitIdentityV1": {
      "additionalProperties": false,
      "description": "Exact, runner-neutral identity of one Portable Agent Kit bundle.",
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "kit_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Kit Id",
          "type": "string"
        },
        "kit_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Kit Version",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "reqpilotx-agent-kit-identity/v1",
          "default": "reqpilotx-agent-kit-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_registry_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Tool Registry Id",
          "type": "string"
        },
        "tool_registry_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Tool Registry Version",
          "type": "string"
        }
      },
      "required": [
        "kit_id",
        "kit_version",
        "manifest_sha256",
        "bundle_sha256",
        "policy_id",
        "policy_version",
        "tool_registry_id",
        "tool_registry_version"
      ],
      "title": "AgentKitIdentityV1",
      "type": "object"
    },
    "D2BaseTableReplacementDisposition": {
      "enum": [
        "REPLACED_BY_REGION_TOPOLOGY",
        "PRESERVED_AS_UNRESOLVED_LINEAGE"
      ],
      "title": "D2BaseTableReplacementDisposition",
      "type": "string"
    },
    "D2EmptyPhysicalTableDispositionKind": {
      "enum": [
        "NON_BUSINESS_FALSE_REGION",
        "UNRESOLVED"
      ],
      "title": "D2EmptyPhysicalTableDispositionKind",
      "type": "string"
    },
    "D2LogicalObjectKind": {
      "enum": [
        "DOCUMENT_UNIT",
        "SECTION",
        "PROVISION_SCOPE",
        "TABLE",
        "FIGURE",
        "ATTACHMENT",
        "CONTEXT",
        "OTHER"
      ],
      "title": "D2LogicalObjectKind",
      "type": "string"
    },
    "D2LogicalObjectV2": {
      "additionalProperties": false,
      "properties": {
        "base_logical_object_id": {
          "anyOf": [
            {
              "pattern": "^(?:d2-logical-object|agent-logical-table)-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Logical Object Id"
        },
        "base_logical_object_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Logical Object Sha256"
        },
        "logical_object_id": {
          "pattern": "^(?:(?:d2-logical-object|agent-logical-table|d2-table-logical-scope|d2-v2-region-object)-[0-9a-f]{32})$",
          "title": "Logical Object Id",
          "type": "string"
        },
        "nested_evidence_region_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Nested Evidence Region Ids",
          "type": "array"
        },
        "object_kind": {
          "$ref": "#/$defs/D2LogicalObjectKind"
        },
        "object_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/D2V2LogicalObjectOrigin"
        },
        "page_numbers": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Page Numbers",
          "type": "array"
        },
        "parent_logical_object_id": {
          "anyOf": [
            {
              "pattern": "^(?:(?:d2-logical-object|agent-logical-table|d2-table-logical-scope|d2-v2-region-object)-[0-9a-f]{32})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Logical Object Id"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "region_logical_scope_id": {
          "anyOf": [
            {
              "pattern": "^d2-table-logical-scope-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Logical Scope Id"
        },
        "region_logical_scope_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Logical Scope Sha256"
        },
        "source_order": {
          "minimum": 0,
          "title": "Source Order",
          "type": "integer"
        },
        "source_region_logical_object_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Region Logical Object Ids",
          "type": "array"
        },
        "source_segments": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "BASE_SOURCE_SEGMENT": "#/$defs/D2V2BaseSourceSegmentRefV1",
                "TABLE_REGION": "#/$defs/D2V2TableRegionSourceSegmentRefV1"
              },
              "propertyName": "segment_kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/D2V2BaseSourceSegmentRefV1"
              },
              {
                "$ref": "#/$defs/D2V2TableRegionSourceSegmentRefV1"
              }
            ]
          },
          "title": "Source Segments",
          "type": "array"
        },
        "supplemental_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supplemental Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "logical_object_id",
        "origin",
        "object_kind",
        "source_order",
        "reason_codes",
        "object_sha256"
      ],
      "title": "D2LogicalObjectV2",
      "type": "object"
    },
    "D2LogicalStructureStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ],
      "title": "D2LogicalStructureStatus",
      "type": "string"
    },
    "D2SourceHandleKind": {
      "enum": [
        "SOURCE_NODE",
