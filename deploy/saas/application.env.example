# Non-secret template; do not put passwords, invite codes or provider keys here.
REQPILOT_ENV=local
REQPILOT_SAAS_ENABLED=1
# Private first: literal loopback HTTP is an explicit smoke-test exception.
# A later public deployment MUST use https://<approved-host> and Secure cookies.
REQPILOT_SAAS_ORIGIN=http://127.0.0.1:8000
REQPILOT_ALLOWED_HOSTS=127.0.0.1,localhost
REQPILOT_ALLOWED_ORIGINS=http://127.0.0.1:8000
REQPILOT_SAAS_SESSION_SECONDS=28800
REQPILOT_SAAS_INVITE_CODE_FILE=/etc/reqpilotx/secrets/invitation_code
# Native profile: same-name OS/PG role, Unix socket + peer auth, no database password.
REQPILOT_DATABASE_URL=postgresql:///reqpilotx?host=/var/run/postgresql
REQPILOT_OBJECT_STORE=local
REQPILOT_STORAGE_DIR=/var/lib/reqpilotx/application
REQPILOT_OBJECT_ROOT=/var/lib/reqpilotx/application
REQPILOT_SCRATCH_ROOT=/var/lib/reqpilotx/application/scratch
REQPILOT_FRONTEND_DIR=/opt/reqpilotx/current/frontend
REQPILOT_LISTEN_HOST=127.0.0.1
REQPILOT_PORT=8000
REQPILOT_TRUSTED_PROXY_IPS=127.0.0.1
REQPILOT_LOCAL_WORKER_COUNT=1
REQPILOT_AGENT_RUNTIME=none
REQPILOT_AGENT_CUSTOMER_DATA_ENABLED=0
REQPILOT_JOB_LEASE_SECONDS=120
REQPILOT_JOB_POLL_SECONDS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MALLOC_ARENA_MAX=2
