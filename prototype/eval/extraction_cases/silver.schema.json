{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqpilotx.local/schemas/pdf-shadow-silver-v1.json",
  "title": "ReqPilotX PDF shadow silver registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "documents"],
  "properties": {
    "schema_version": {
      "const": "pdf-shadow-silver/v1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "reviewed_by", "reviewed_at_utc", "limitations"],
      "properties": {
        "label": {"const": "AI_REVIEWED_SILVER"},
        "reviewed_by": {"const": "ai_assistant"},
        "reviewed_at_utc": {"type": "string", "format": "date-time"},
        "limitations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "not_human_gold",
              "not_a_serving_activation_gate",
              "source_hash_and_visual_asset_bound"
            ]
          }
        }
      }
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^DOC-[A-Z0-9-]+$"},
      "additionalProperties": {"$ref": "#/$defs/document_silver"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "outline_label": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}(?:\\.(?:0|[1-9][0-9]{0,2})){0,7}$"
    },
    "bbox_q100": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "integer"},
        {"type": "integer"},
        {"type": "integer"},
        {"type": "integer"}
      ],
      "items": false
    },
    "positive_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false
    },
    "image_cell_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "span", "bbox_q100"],
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "column": {"type": "integer", "minimum": 0},
        "span": {"$ref": "#/$defs/positive_pair"},
        "bbox_q100": {"$ref": "#/$defs/bbox_q100"}
      }
    },
    "image_cell_ownership_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "table", "relation_kind"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_number",
            "block_index",
            "kind",
            "content_sha256",
            "bbox_q100"
          ],
          "properties": {
            "page_number": {"type": "integer", "minimum": 1},
            "block_index": {"type": "integer", "minimum": 0},
            "kind": {"enum": ["image", "figure"]},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "bbox_q100": {"$ref": "#/$defs/bbox_q100"}
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "bbox_q100", "shape"],
          "properties": {
            "index": {"type": "integer", "minimum": 0},
            "bbox_q100": {"$ref": "#/$defs/bbox_q100"},
            "shape": {"$ref": "#/$defs/positive_pair"}
          }
        },
        "cell": {"$ref": "#/$defs/image_cell_binding"},
        "cells": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/image_cell_binding"}
        },
        "relation_kind": {"enum": ["placed_in_cell", "placed_over_cells"]}
      },
      "oneOf": [
        {
          "properties": {"relation_kind": {"const": "placed_in_cell"}},
          "required": ["cell"],
          "not": {"required": ["cells"]}
        },
        {
          "properties": {"relation_kind": {"const": "placed_over_cells"}},
          "required": ["cells"],
          "not": {"required": ["cell"]}
        }
      ]
    },
    "document_silver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "projection_policy",
        "case_ids",
        "allowed_visual_provider_ids",
        "page_assets",
        "visual_text_fidelity_expectations",
        "outline_chains",
        "continuations",
        "numbered_children",
        "semantic_expectations",
        "projection_expectations",
        "finding_expectations",
        "projection_scope_expectations",
        "diagnostic_expectations",
        "native_block_disposition_expectations",
        "structure_scope_expectations",
        "table_expectations",
        "table_note_expectations",
        "revision_history_expectations",
        "figure_expectations",
        "image_mask_composite_expectations",
        "image_cell_ownership_expectations",
        "option_state_expectations"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "projection_policy": {
          "enum": ["SHADOW_CANDIDATES", "NON_REQUIREMENT_ARTIFACT"]
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/case_id"}
        },
        "allowed_visual_provider_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "aliyun-bailian-qwen-ocr",
              "azure-document-intelligence"
            ]
          }
        },
        "page_assets": {
          "type": "array",
          "description": "Exact source-bound page scope approved for remote visual text recognition. An empty array disables remote OCR for this document.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_number"],
            "properties": {
              "page_number": {"type": "integer", "minimum": 1},
              "input_rotation_cw_degrees": {
                "type": "integer",
                "enum": [0, 90, 180, 270],
                "default": 0
              },
              "source_asset_sha256": {"$ref": "#/$defs/sha256"},
              "page_image_sha256": {"$ref": "#/$defs/sha256"}
            },
            "oneOf": [
              {
                "required": ["source_asset_sha256"],
                "not": {"required": ["page_image_sha256"]}
              },
              {
                "required": ["page_image_sha256"],
                "not": {"required": ["source_asset_sha256"]}
              }
            ]
          }
        },
        "visual_text_fidelity_expectations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "page_number",
                  "policy_id",
                  "provider_id",
                  "provider_version_sha256",
                  "observation_count",
                  "character_count",
                  "raw_text_bundle_sha256",
                  "layout_bundle_sha256",
                  "reviewed_regions",
                  "projected_requirement_count"
                ],
                "properties": {
                  "case_id": {"$ref": "#/$defs/case_id"},
                  "page_number": {"type": "integer", "minimum": 1},
                  "policy_id": {"const": "visual-text-page-fidelity/v1"},
                  "provider_id": {
                    "enum": [
                      "aliyun-bailian-qwen-ocr",
                      "azure-document-intelligence"
                    ]
                  },
                  "provider_version_sha256": {"$ref": "#/$defs/sha256"},
                  "observation_count": {"type": "integer", "minimum": 1},
                  "character_count": {"type": "integer", "minimum": 1},
                  "raw_text_bundle_sha256": {"$ref": "#/$defs/sha256"},
                  "layout_bundle_sha256": {"$ref": "#/$defs/sha256"},
                  "reviewed_regions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "region_id",
                        "bbox_q100",
                        "observation_count",
                        "character_count",
                        "raw_text_bundle_sha256",
                        "layout_bundle_sha256"
                      ],
                      "properties": {
                        "region_id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,79}$"
                        },
                        "bbox_q100": {"$ref": "#/$defs/bbox_q100"},
                        "observation_count": {"type": "integer", "minimum": 1},
                        "character_count": {"type": "integer", "minimum": 1},
                        "raw_text_bundle_sha256": {"$ref": "#/$defs/sha256"},
                        "layout_bundle_sha256": {"$ref": "#/$defs/sha256"}
                      }
                    }
                  },
                  "projected_requirement_count": {"const": 0}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "page_number",
                  "policy_id",
                  "provider_id",
                  "provider_version_sha256",
                  "coverage_claim",
                  "observation_count_min",
                  "observation_count_max",
                  "character_count_min",
                  "character_count_max",
                  "anchor_order_axis",
                  "ordered_anchors",
                  "reviewed_token_regions",
                  "projected_requirement_count"
                ],
                "properties": {
                  "case_id": {"$ref": "#/$defs/case_id"},
                  "page_number": {"type": "integer", "minimum": 1},
                  "policy_id": {"const": "visual-text-anchor-fidelity/v2"},
                  "provider_id": {
                    "enum": [
                      "aliyun-bailian-qwen-ocr",
                      "azure-document-intelligence"
                    ]
                  },
                  "provider_version_sha256": {"$ref": "#/$defs/sha256"},
                  "coverage_claim": {"const": "reviewed_anchor_sequence"},
                  "observation_count_min": {"type": "integer", "minimum": 1},
                  "observation_count_max": {"type": "integer", "minimum": 1},
                  "character_count_min": {"type": "integer", "minimum": 1},
                  "character_count_max": {"type": "integer", "minimum": 1},
                  "ordered_raw_text_bundle_sha256": {"$ref": "#/$defs/sha256"},
                  "anchor_order_axis": {"enum": ["x", "y"]},
                  "ordered_anchors": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "token_sha256",
                        "axis_center_q100",
                        "max_axis_delta_q100"
                      ],
                      "properties": {
                        "token_sha256": {"$ref": "#/$defs/sha256"},
                        "axis_center_q100": {"type": "integer"},
                        "max_axis_delta_q100": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        }
                      }
                    }
                  },
                  "reviewed_token_regions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "region_id",
                        "bbox_q100",
                        "membership",
                        "required_tokens"
                      ],
                      "properties": {
                        "region_id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,79}$"
                        },
                        "bbox_q100": {"$ref": "#/$defs/bbox_q100"},
                        "membership": {"const": "centroid"},
                        "required_tokens": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["token_sha256", "exact_occurrences"],
                            "properties": {
                              "token_sha256": {"$ref": "#/$defs/sha256"},
                              "exact_occurrences": {
                                "type": "integer",
                                "minimum": 1
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "projected_requirement_count": {"const": 0}
                }
              }
            ]
          }
        },
        "outline_chains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "target_label", "ancestor_labels"],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "target_label": {"$ref": "#/$defs/outline_label"},
              "ancestor_labels": {
                "type": "array",
                "items": {"$ref": "#/$defs/outline_label"}
              }
            }
          }
        },
        "continuations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "section_label",
              "from_page",
              "to_page"
            ],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "from_page": {"type": "integer", "minimum": 1},
              "to_page": {"type": "integer", "minimum": 1},
              "node_kind": {
                "enum": [
                  "section",
                  "clause",
                  "content",
                  "table",
                  "table_row",
                  "list_group",
                  "group",
                  "continuation"
                ]
              },
              "numbered_child_count": {"type": "integer", "minimum": 0},
              "pseudo_primary_requirement_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "numbered_children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "section_label", "ordinals"],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "ordinals": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "semantic_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "section_label",
              "semantic_class",
              "requirement_subtype"
            ],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "semantic_class": {
                "enum": [
                  "HEADING",
                  "REQUIREMENT",
                  "BACKGROUND",
                  "TECHNICAL_INFORMATION",
                  "SCHEDULE",
                  "REFERENCE",
                  "PROJECT_RISK",
                  "VERSION_METADATA",
                  "ATTACHMENT",
                  "NOISE",
                  "UNRESOLVED"
                ]
              },
              "requirement_subtype": {
                "type": ["string", "null"],
                "enum": [
                  "PRODUCT_REQUIREMENT",
                  "PERFORMANCE_PARAMETER_REQUIREMENT",
                  "TEST_METHOD_REQUIREMENT",
                  "TEST_EQUIPMENT_REQUIREMENT",
                  "TEST_OBJECTIVE_REQUIREMENT",
                  "ACCEPTANCE_CRITERION",
                  "REGULATION_REQUIREMENT",
                  "INTERFACE_REQUIREMENT",
                  null
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {"semantic_class": {"const": "REQUIREMENT"}}
                },
                "then": {
                  "properties": {
                    "requirement_subtype": {"type": "string"}
                  }
                },
                "else": {
                  "properties": {
                    "requirement_subtype": {"type": "null"}
                  }
                }
              }
            ]
          }
        },
        "projection_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_label",
              "case_id",
              "primary_count",
              "content_child_count",
              "top_level_requirement_count",
              "primary_decision_mode"
            ],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "primary_count": {"type": "integer", "minimum": 0},
              "content_child_count": {"type": "integer", "minimum": 0},
              "top_level_requirement_count": {"type": "integer", "minimum": 0},
              "primary_decision_mode": {"enum": ["DIRECT", "ROLLUP", "NONE"]}
            }
          }
        },
        "finding_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "code", "count"],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,119}$"
              },
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "projection_scope_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "section_label", "count"],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "role": {
                "enum": ["PRIMARY", "CHILD", "CONTENT", "PARAMETER", "REFERENCE"]
              },
              "target_kind": {
                "enum": [
                  "section",
                  "clause",
                  "content",
                  "table",
                  "table_row",
                  "list_group",
                  "group",
                  "continuation"
                ]
              },
              "count": {"type": "integer", "minimum": 0}
            },
            "anyOf": [
              {"required": ["role"]},
              {"required": ["target_kind"]}
            ]
          }
        },
        "diagnostic_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "code", "count"],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,119}$"
              },
              "page_number": {"type": "integer", "minimum": 1},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "native_block_disposition_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "disposition",
              "content_sha256",
              "locators",
              "expected_source_status",
              "source_node_count",
              "asset_count",
              "diagnostic_code",
              "forbidden_diagnostic_code"
            ],
            "properties": {
              "disposition": {
                "const": "exclude_tiling_pattern_tile_from_content"
              },
              "content_sha256": {"$ref": "#/$defs/sha256"},
              "locators": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["page_number", "block_index"],
                  "properties": {
                    "page_number": {"type": "integer", "minimum": 1},
                    "block_index": {"type": "integer", "minimum": 0}
                  }
                }
              },
              "expected_source_status": {"const": "COMPLETE"},
              "source_node_count": {"const": 0},
              "asset_count": {"type": "integer", "minimum": 0},
              "diagnostic_code": {
                "const": "pdf_tiling_pattern_tile_excluded"
              },
              "forbidden_diagnostic_code": {
                "const": "pdf_block_bbox_missing"
              }
            }
          }
        },
        "structure_scope_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "section_label", "target_kind", "count"],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "target_kind": {
                "enum": [
                  "section",
                  "clause",
                  "content",
                  "table",
                  "table_row",
                  "list_group",
                  "group",
                  "continuation"
                ]
              },
              "direct_only": {"type": "boolean", "default": false},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "table_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "section_label",
              "page_number",
              "row_count",
              "column_count",
              "count"
            ],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "page_number": {"type": "integer", "minimum": 1},
              "row_count": {"type": "integer", "minimum": 1},
              "column_count": {"type": "integer", "minimum": 1},
              "parent_list_ordinal": {"type": "integer", "minimum": 1},
              "parent_ordinal_occurrence": {"type": "integer", "minimum": 1},
              "count": {"type": "integer", "minimum": 0}
            },
            "dependentRequired": {
              "parent_list_ordinal": ["parent_ordinal_occurrence"],
              "parent_ordinal_occurrence": ["parent_list_ordinal"]
            }
          }
        },
        "table_note_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "section_label",
              "page_number",
              "row_count",
              "column_count",
              "note_row_index",
              "applies_to_row_indices"
            ],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "section_label": {"$ref": "#/$defs/outline_label"},
              "page_number": {"type": "integer", "minimum": 1},
              "row_count": {"type": "integer", "minimum": 3},
              "column_count": {"type": "integer", "minimum": 2},
              "note_row_index": {"type": "integer", "minimum": 2},
              "applies_to_row_indices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "revision_history_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "page_number",
              "table_index",
              "row_count",
              "column_count",
              "revision_row_indices",
              "projected_requirement_count"
            ],
            "properties": {
              "case_id": {"$ref": "#/$defs/case_id"},
              "page_number": {"type": "integer", "minimum": 1},
              "table_index": {"type": "integer", "minimum": 0},
              "row_count": {"type": "integer", "minimum": 3},
              "column_count": {"type": "integer", "minimum": 2},
              "revision_row_indices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 0}
              },
              "projected_requirement_count": {"const": 0}
            }
          }
        },
        "figure_expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "section_label",
              "page_number",
              "source_node_kind",
              "content_sha256",
              "asset_count",
              "placement_count",
              "structure_count",
              "reference_relation_count",
              "projected_requirement_count",
              "projection_role",
              "decision_mode"
            ],
            "properties": {
