# Existing local application: no automatic cloud access.
REQPILOT_ENV=local
REQPILOT_PROCESS_ROLE=api
REQPILOT_DATABASE_URL=postgresql://127.0.0.1/reqpilotx
REQPILOT_OBJECT_STORE=local
REQPILOT_OBJECT_ROOT=/absolute/private/path/reqpilotx-runtime
REQPILOT_SCRATCH_ROOT=/absolute/private/path/reqpilotx-runtime
REQPILOT_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
REQPILOT_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost,http://[::1]
REQPILOT_LOCAL_WORKER_COUNT=2

# Template only; this file is not automatically loaded.
# Keep actual credentials, approved login state and customer data outside Git.

# Current Codex-backed Agent/reading environment. Use approved real paths.
# REQPILOT_CODEX_BIN=/absolute/path/to/codex
# REQPILOT_CODEX_HOME=/absolute/private/codex-home
# REQPILOT_AGENT_MODEL_ID=<available-model-id>
# REQPILOT_READING_AI_TIMEOUT_SECONDS=180
# REQPILOT_READING_DIRECT_INPUT_TOKEN_BUDGET=850000
# Codex readiness is not established by the presence of Azure/Bailian keys.
# Legacy provider settings below do not select a fallback for the AI reader.

# Optional legacy/knowledge adapters; enable only for an explicitly scoped task.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# REQPILOT_ALIYUN_API_KEY=
# REQPILOT_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# REQPILOT_ALIYUN_CHAT_MODEL=<chat-model>
# REQPILOT_ALIYUN_EMBEDDING_MODEL=<embedding-model>
# REQPILOT_ALIYUN_RETRIEVAL_BACKEND=qdrant
# REQPILOT_ALIYUN_QDRANT_URL=http://127.0.0.1:6333
# REQPILOT_ALIYUN_QDRANT_COLLECTION=<project-scoped-collection>
# REQPILOT_ALIYUN_QDRANT_API_KEY=
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
# REQPILOT_AZURE_AUTH_MODE=rbac
# REQPILOT_AZURE_ALLOW_INTERACTIVE_LOGIN=0
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=<approved-api-version>
# AZURE_OPENAI_SOL_DEPLOYMENT=<deployment>
# AZURE_OPENAI_TERRA_DEPLOYMENT=<deployment>
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment>
# AZURE_AI_SEARCH_ENDPOINT=https://<resource>.search.windows.net
# AZURE_AI_SEARCH_INDEX_NAME=<project-index>

# Retained visual-sidecar adapter: explicit authorization required for page upload.
# REQPILOT_READING_VISUAL_PROVIDER=bailian-qwen3.8-max-pdf-parsing
# REQPILOT_READING_VISUAL_MODEL=qwen3.8-max
# REQPILOT_READING_VISUAL_TIMEOUT_SECONDS=300
# REQPILOT_READING_VISUAL_MAX_RETRIES=0
# REQPILOT_READING_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# REQPILOT_READING_ALIYUN_API_KEY=
# This compatibility adapter is not the default Codex reading workflow.

# Deferred cloud deployment reference. Do not enable during baseline cleanup.
# REQPILOT_ENV=cloud
# REQPILOT_DATABASE_URL=postgresql://<user>:<secret>@<rds-private-host>:5432/reqpilotx
