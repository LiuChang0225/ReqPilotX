{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reqpilotx:agent-evals:cases:v1",
  "title": "ReqPilotX Agent Eval case catalog",
  "description": "Public task catalog only. Resolve originals from operator private bindings; source paths, old answers and private scoring are never agent-visible fields. READY_WITH_PRIVATE_BINDING requires a runtime hash-verified private binding, not a completed result. PENDING_INPUT cases cannot run. Development sources must not be relabeled as unseen held-out evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "suite_id": {
      "const": "reqpilotx-agent-evals-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "title",
          "source_key",
          "source_sha256",
          "partition",
          "status",
          "scope",
          "task_goal",
          "tags",
          "rubric_ids",
          "capability_focus",
          "agent_visible_fields"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "source_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "partition": {
            "enum": [
              "development",
              "regression",
              "held_out"
            ]
          },
          "status": {
            "enum": [
              "READY_WITH_PRIVATE_BINDING",
              "PENDING_INPUT",
              "RETIRED"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "MAP_ONLY",
              "FULL_DOCUMENT",
              "SCOPED_REVISION",
              "SCOPED_EXTRACTION"
            ]
          },
          "task_goal": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "rubric_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "capability_focus": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "agent_visible_fields": {
            "const": [
              "task_goal"
            ]
          },
          "preparation": {
            "enum": [
              "SOURCE_ONLY",
              "STAGE_FIXTURE"
            ]
          },
          "fixture_key": {
            "type": "string"
          },
          "fixture_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "oracle_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "catalogue_case_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "catalogue_document_id": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "READY_WITH_PRIVATE_BINDING"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "preparation": {
                  "const": "STAGE_FIXTURE"
                }
              },
              "required": [
                "preparation"
              ]
            },
            "then": {
              "required": [
                "fixture_key",
                "fixture_sha256",
                "oracle_sha256"
              ],
              "properties": {
                "scope": {
                  "const": "SCOPED_REVISION"
                }
              }
            }
          }
        ]
      }
    }
  }
}
