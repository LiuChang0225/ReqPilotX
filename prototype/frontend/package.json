    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.0.0",
    "postcss-selector-parser": "^7.1.0",
    "typescript": "7.0.2",
