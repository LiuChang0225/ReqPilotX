{
  "$defs": {
    "AgentKitIdentityV1": {
      "additionalProperties": false,
      "description": "Exact, runner-neutral identity of one Portable Agent Kit bundle.",
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "kit_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Kit Id",
          "type": "string"
        },
        "kit_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Kit Version",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "reqpilotx-agent-kit-identity/v1",
          "default": "reqpilotx-agent-kit-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_registry_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Tool Registry Id",
          "type": "string"
        },
        "tool_registry_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Tool Registry Version",
          "type": "string"
        }
      },
      "required": [
        "kit_id",
        "kit_version",
        "manifest_sha256",
        "bundle_sha256",
        "policy_id",
        "policy_version",
        "tool_registry_id",
        "tool_registry_version"
      ],
      "title": "AgentKitIdentityV1",
      "type": "object"
    },
    "D2LogicalStructureStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ],
      "title": "D2LogicalStructureStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^agent-artifact-[0-9a-f]{32}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "d1_table_map_artifact_id": {
      "maxLength": 240,
      "minLength": 1,
      "title": "D1 Table Map Artifact Id",
      "type": "string"
    },
    "d1_table_map_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "D1 Table Map Artifact Sha256",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "kit_identity": {
      "$ref": "#/$defs/AgentKitIdentityV1"
    },
    "logical_object_ids": {
      "items": {
        "type": "string"
      },
      "title": "Logical Object Ids",
      "type": "array"
    },
    "logical_table_scope_ids": {
      "items": {
        "type": "string"
      },
      "title": "Logical Table Scope Ids",
      "type": "array"
    },
    "physical_table_ids": {
      "items": {
        "type": "string"
      },
      "title": "Physical Table Ids",
      "type": "array"
    },
    "predecessor_d1_artifact_id": {
      "pattern": "^agent-artifact-[0-9a-f]{32}$",
      "title": "Predecessor D1 Artifact Id",
      "type": "string"
    },
    "predecessor_d1_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Predecessor D1 Artifact Sha256",
      "type": "string"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Sha256",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^agent-run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "logical-structure-validation-receipt/v1",
      "default": "logical-structure-validation-receipt/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_disposition_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Evidence Disposition Ids",
      "type": "array"
    },
    "source_ir_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Ir Canonical Sha256",
      "type": "string"
    },
    "source_ir_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Source Ir Id",
      "type": "string"
    },
    "source_segment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Segment Ids",
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/D2LogicalStructureStatus"
    },
    "unresolved_source_evidence_disposition_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Source Evidence Disposition Ids",
      "type": "array"
    },
    "unresolved_table_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Table Ids",
      "type": "array"
    },
    "validator_id": {
      "const": "reqpilotx-logical-structure-validator",
      "default": "reqpilotx-logical-structure-validator",
      "title": "Validator Id",
      "type": "string"
    },
    "validator_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Validator Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_sha256",
    "run_id",
    "source_sha256",
    "source_ir_id",
    "source_ir_canonical_sha256",
    "kit_identity",
    "predecessor_d1_artifact_id",
    "predecessor_d1_artifact_sha256",
    "d1_table_map_artifact_id",
    "d1_table_map_artifact_sha256",
    "status",
    "logical_object_ids",
    "source_segment_ids",
    "logical_table_scope_ids",
    "source_evidence_disposition_ids",
    "unresolved_source_evidence_disposition_ids",
    "physical_table_ids",
    "unresolved_table_ids",
    "proposal_sha256",
    "evidence_sha256",
    "receipt_sha256"
  ],
  "title": "D2LogicalStructureValidationReceiptV1",
  "type": "object"
}
