{
  "$defs": {
    "AgentExtractionStage": {
      "enum": [
        "D0_SOURCE_PREFLIGHT",
        "D1_DOCUMENT_UNDERSTANDING",
        "D2_LOGICAL_STRUCTURE",
        "D3_PARENT_PROVISION_RECOGNITION",
        "D4_REQUIREMENT_DECOMPOSITION",
        "D5_COMPLETENESS_VERIFICATION",
        "D6_RESULT_ASSEMBLY"
      ],
      "title": "AgentExtractionStage",
      "type": "string"
    },
    "AgentStageArtifactStatus": {
      "enum": [
        "VALIDATED",
        "PARTIAL",
        "BLOCKED"
      ],
      "title": "AgentStageArtifactStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Small final model response bound to a Host-validated stage proposal.",
  "properties": {
    "artifact_status": {
      "$ref": "#/$defs/AgentStageArtifactStatus"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "kit_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Kit Bundle Sha256",
      "type": "string"
    },
    "proposal_schema_id": {
      "pattern": "^[a-z][a-z0-9-]{0,119}/v[0-9]+$",
      "title": "Proposal Schema Id",
      "type": "string"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^agent-run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-stage-final-receipt/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/AgentExtractionStage"
    },
    "validation_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Receipt Sha256",
      "type": "string"
    },
    "validator_id": {
      "pattern": "^[a-z][a-z0-9-]{0,119}$",
      "title": "Validator Id",
      "type": "string"
    },
    "validator_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Validator Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_sha256",
    "stage",
    "kit_bundle_sha256",
    "artifact_status",
    "proposal_schema_id",
    "proposal_sha256",
    "evidence_sha256",
    "validation_receipt_sha256",
    "validator_id",
    "validator_version"
  ],
  "title": "AgentStageFinalReceiptV1",
  "type": "object"
}
