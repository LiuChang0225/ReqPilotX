{
  "$defs": {
    "AgentExtractionStage": {
      "enum": [
        "D0_SOURCE_PREFLIGHT",
        "D1_DOCUMENT_UNDERSTANDING",
        "D2_LOGICAL_STRUCTURE",
        "D3_PARENT_PROVISION_RECOGNITION",
        "D4_REQUIREMENT_DECOMPOSITION",
        "D5_COMPLETENESS_VERIFICATION",
        "D6_RESULT_ASSEMBLY"
      ],
      "title": "AgentExtractionStage",
      "type": "string"
    },
    "AgentKitIdentityV1": {
      "additionalProperties": false,
      "description": "Exact, runner-neutral identity of one Portable Agent Kit bundle.",
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "kit_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Kit Id",
          "type": "string"
        },
        "kit_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Kit Version",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "reqpilotx-agent-kit-identity/v1",
          "default": "reqpilotx-agent-kit-identity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_registry_id": {
          "pattern": "^[a-z][a-z0-9-]{0,119}$",
          "title": "Tool Registry Id",
          "type": "string"
        },
        "tool_registry_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Tool Registry Version",
          "type": "string"
        }
      },
      "required": [
        "kit_id",
        "kit_version",
        "manifest_sha256",
        "bundle_sha256",
        "policy_id",
        "policy_version",
        "tool_registry_id",
        "tool_registry_version"
      ],
      "title": "AgentKitIdentityV1",
      "type": "object"
    },
    "AgentWorkflowMode": {
      "description": "The two product workflows intentionally have different stage orders.",
      "enum": [
        "BASELINE",
        "ATOMIZATION"
      ],
      "title": "AgentWorkflowMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Runner-neutral request. It intentionally contains no path or source text.",
  "properties": {
    "accepted_baseline_artifact_id": {
      "anyOf": [
        {
          "pattern": "^agent-artifact-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Baseline Artifact Id"
    },
    "accepted_baseline_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Baseline Artifact Sha256"
    },
    "customer_data_authorized": {
      "default": false,
      "title": "Customer Data Authorized",
      "type": "boolean"
    },
    "document_role": {
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
      "title": "Document Role",
      "type": "string"
    },
    "explicit_user_trigger": {
      "default": false,
      "title": "Explicit User Trigger",
      "type": "boolean"
    },
    "kit_identity": {
      "$ref": "#/$defs/AgentKitIdentityV1"
    },
    "model_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "opaque_source_handle": {
      "pattern": "^source-handle-[0-9a-f]{32}$",
      "title": "Opaque Source Handle",
      "type": "string"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "reasoning_effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "title": "Reasoning Effort",
      "type": "string"
    },
    "run_id": {
      "pattern": "^agent-run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "runner_profile_id": {
      "pattern": "^[a-z][a-z0-9-]{0,119}$",
      "title": "Runner Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "reqpilotx-agent-execution-request/v1",
      "default": "reqpilotx-agent-execution-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_scope_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Scope Sha256"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "stages": {
      "default": [
        "D0_SOURCE_PREFLIGHT",
        "D1_DOCUMENT_UNDERSTANDING",
        "D2_LOGICAL_STRUCTURE",
        "D3_PARENT_PROVISION_RECOGNITION",
        "D5_COMPLETENESS_VERIFICATION",
        "D6_RESULT_ASSEMBLY"
      ],
      "items": {
        "$ref": "#/$defs/AgentExtractionStage"
      },
      "title": "Stages",
      "type": "array"
    },
    "workflow_mode": {
      "$ref": "#/$defs/AgentWorkflowMode",
      "default": "BASELINE"
    }
  },
  "required": [
    "run_id",
    "opaque_source_handle",
    "source_sha256",
    "page_count",
    "document_role",
    "runner_profile_id",
    "model_id",
    "reasoning_effort",
    "kit_identity"
  ],
  "title": "AgentExecutionRequestV1",
  "type": "object"
}
