{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqpilotx.local/schemas/pdf-body-review-draft.v1.json",
  "title": "ReqPilotX PDF body review draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "location_class",
    "is_human_gold",
    "profile_sha256",
    "profile"
  ],
  "properties": {
    "schema_version": { "const": "pdf_body_review_draft.v1" },
    "status": { "const": "DRAFT" },
    "location_class": { "const": "CONTROLLED_EXTERNAL" },
    "is_human_gold": { "const": false },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/profile" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "expected_body_line_count",
        "expected_image_count",
        "image_occurrences",
        "image_content_multiset_sha256",
        "image_sequence_sha256",
        "table_occurrences",
        "table_content_multiset_sha256",
        "table_sequence_sha256",
        "expected_table_count",
        "expected_table_row_count",
        "expected_table_cell_count",
        "expected_merged_region_count",
        "content_multiset_sha256",
        "sequence_sha256"
      ],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "page_image_sha256": { "$ref": "#/$defs/sha256" },
        "expected_body_line_count": { "type": "integer", "minimum": 0 },
        "expected_image_count": { "type": "integer", "minimum": 0 },
        "image_occurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/imageOccurrence" }
        },
        "image_content_multiset_sha256": { "$ref": "#/$defs/sha256" },
        "image_sequence_sha256": { "$ref": "#/$defs/sha256" },
        "table_occurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableOccurrence" }
        },
        "table_content_multiset_sha256": { "$ref": "#/$defs/sha256" },
        "table_sequence_sha256": { "$ref": "#/$defs/sha256" },
        "expected_table_count": { "type": "integer", "minimum": 0 },
        "expected_table_row_count": { "type": "integer", "minimum": 0 },
        "expected_table_cell_count": { "type": "integer", "minimum": 0 },
        "expected_merged_region_count": { "type": "integer", "minimum": 0 },
        "content_multiset_sha256": { "$ref": "#/$defs/sha256" },
        "sequence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "imageDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base_content_sha256",
        "mask_content_sha256"
      ],
      "properties": {
        "kind": { "const": "alpha_mask_composite" },
        "base_content_sha256": { "$ref": "#/$defs/sha256" },
        "mask_content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nativePdfImageLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "page_number", "block_index", "bbox"],
      "properties": {
        "format": { "const": "pdf" },
        "page_number": { "type": "integer", "minimum": 1 },
        "block_index": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        }
      }
    },
    "imageOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_sha256",
        "source_order",
        "node_kind",
        "asset_kind",
        "media_type",
        "content_sha256",
        "native_locator",
        "derivation",
        "disposition"
      ],
      "properties": {
        "occurrence_sha256": { "$ref": "#/$defs/sha256" },
        "source_order": { "type": "integer", "minimum": 0 },
        "node_kind": { "enum": ["image", "figure"] },
        "asset_kind": { "enum": ["image", "figure", "page_render"] },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
        },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "native_locator": { "$ref": "#/$defs/nativePdfImageLocator" },
        "derivation": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/imageDerivation" }
          ]
        },
        "disposition": {
          "enum": ["CONTENT", "NON_CONTENT", "UNRESOLVED"]
        }
      }
    },
    "tableOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_sha256",
        "provider_object_id_sha256",
        "provider_index",
        "page_number",
        "bbox",
        "row_count",
        "column_count",
        "cell_count",
        "merged_region_count",
        "topology_sha256",
        "disposition"
      ],
      "properties": {
        "occurrence_sha256": { "$ref": "#/$defs/sha256" },
        "provider_object_id_sha256": { "$ref": "#/$defs/sha256" },
        "provider_index": { "type": "integer", "minimum": 0 },
        "page_number": { "type": "integer", "minimum": 1 },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "row_count": { "type": "integer", "minimum": 1 },
        "column_count": { "type": "integer", "minimum": 1 },
        "cell_count": { "type": "integer", "minimum": 1 },
        "merged_region_count": { "type": "integer", "minimum": 0 },
        "topology_sha256": { "$ref": "#/$defs/sha256" },
        "disposition": {
          "enum": ["CONTENT", "NON_CONTENT", "UNRESOLVED"]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "assertion_id",
        "evaluator_id",
        "document_id",
        "source_sha256",
        "body_page_start",
        "body_page_end",
        "review_mode",
        "pages"
      ],
      "properties": {
        "schema_version": { "const": "pdf_body_review_profile.v1" },
        "assertion_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "evaluator_id": {
          "const": "source_ir.pdf_reviewed_body_sequence/v1"
        },
        "document_id": {
          "type": "string",
          "pattern": "^DOC-[A-Z0-9-]+$"
        },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "body_page_start": { "type": "integer", "minimum": 1 },
        "body_page_end": { "type": "integer", "minimum": 1 },
        "review_mode": { "enum": ["NATIVE", "REMOTE_VISUAL"] },
        "approved_visual_provider": {
          "enum": ["bailian", "azure-document-intelligence"]
        },
        "visual_provider_id": {
          "enum": [
            "aliyun-bailian-qwen-ocr",
            "azure-document-intelligence"
          ]
        },
        "visual_text_provider_version_sha256": { "$ref": "#/$defs/sha256" },
        "visual_table_provider_version_sha256": { "$ref": "#/$defs/sha256" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "review_mode": { "const": "NATIVE" } },
            "required": ["review_mode"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["approved_visual_provider"] },
                { "required": ["visual_provider_id"] },
                { "required": ["visual_text_provider_version_sha256"] },
                { "required": ["visual_table_provider_version_sha256"] }
              ]
            },
            "properties": {
              "pages": {
                "items": {
                  "not": { "required": ["page_image_sha256"] }
                }
              }
            }
          },
          "else": {
            "required": [
              "approved_visual_provider",
              "visual_provider_id",
              "visual_text_provider_version_sha256",
              "visual_table_provider_version_sha256"
            ],
            "properties": {
              "pages": {
                "items": { "required": ["page_image_sha256"] }
              }
            }
          }
        }
      ]
    }
  }
}
