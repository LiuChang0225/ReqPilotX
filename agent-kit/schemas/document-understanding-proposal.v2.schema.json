{
  "$defs": {
    "DocumentEvidenceAuthority": {
      "enum": [
        "NATIVE",
        "VISUAL",
        "NATIVE_AND_VISUAL",
        "INTENTIONAL_BLANK",
        "UNRESOLVED"
      ],
      "title": "DocumentEvidenceAuthority",
      "type": "string"
    },
    "DocumentUnderstandingPageV2": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "authority": {
          "$ref": "#/$defs/DocumentEvidenceAuthority"
        },
        "page_facts_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Page Facts Sha256",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "page_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Page Text Sha256",
          "type": "string"
        },
        "table_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Table Ids",
          "type": "array"
        },
        "unresolved_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved Codes",
          "type": "array"
        },
        "visual_observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentVisualObservationV2"
          },
          "title": "Visual Observations",
          "type": "array"
        }
      },
      "required": [
        "page_number",
        "authority",
        "page_facts_sha256",
        "page_text_sha256"
      ],
      "title": "DocumentUnderstandingPageV2",
      "type": "object"
    },
    "DocumentUnderstandingStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ],
      "title": "DocumentUnderstandingStatus",
      "type": "string"
    },
    "DocumentVisualObservationKind": {
      "enum": [
        "HEADING",
        "TEXT",
        "TABLE",
        "FIGURE",
        "MARK",
        "OTHER"
      ],
      "title": "DocumentVisualObservationKind",
      "type": "string"
    },
    "DocumentVisualObservationV2": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DocumentVisualObservationKind"
        },
        "source_handles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Handles",
          "type": "array"
        },
        "visible_text": {
          "default": "",
          "maxLength": 4000,
          "title": "Visible Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "image_sha256"
      ],
      "title": "DocumentVisualObservationV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ledger_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ledger Sha256",
      "type": "string"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/DocumentUnderstandingPageV2"
      },
      "title": "Pages",
      "type": "array"
    },
    "run_id": {
      "pattern": "^agent-run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "document-understanding-proposal/v2",
      "default": "document-understanding-proposal/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DocumentUnderstandingStatus"
    }
  },
  "required": [
    "run_id",
    "source_sha256",
    "page_count",
    "ledger_sha256",
    "status",
    "pages"
  ],
  "title": "DocumentUnderstandingProposalV2",
  "type": "object"
}
