    "visible_page_evidence",
    "native_source_facts",
    "typed_parser_facts",
    "typed_resolver_suggestions"
  ],
  "ontology": [
    "DOCUMENT_CONTAINER",
    "SECTION_CONTAINER",
    "ATTACHMENT_CONTAINER",
    "LOGICAL_TABLE_CONTAINER",
    "LOGICAL_RECORD",
