{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqpilotx.local/schemas/document-visual-render-profile-v1.json",
  "title": "ReqPilotX controlled document visual render profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_hash_contract",
    "profile_sha256",
    "source",
    "renderer",
    "page_count",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "document-visual-render-profile/v1"
    },
    "profile_hash_contract": {
      "const": "canonical-json-without-profile-sha256/v1"
    },
    "profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "renderer": {
      "$ref": "#/$defs/renderer"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "format"
      ],
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "enum": [
            "docx",
            "xlsx",
            "xlsb",
            "tif"
          ]
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "config_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safe_id"
        },
        "version": {
          "$ref": "#/$defs/safe_id"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type",
        "width_px",
        "height_px"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "const": "image/png"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "frame_index"
          ],
          "properties": {
            "kind": {
              "const": "TIF_FRAME"
            },
            "frame_index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "dependentRequired": {
            "sheet_locator": [
              "sheet_page_number"
            ],
            "sheet_page_number": [
              "sheet_locator"
            ]
          },
          "properties": {
            "kind": {
              "const": "OFFICE_PAGE"
            },
            "sheet_locator": {
              "$ref": "#/$defs/safe_id"
            },
            "sheet_page_number": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "locator",
        "artifact"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  }
}
